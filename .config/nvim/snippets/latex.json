{
		"template" : {
			"prefix" : "template",
			"body" : [
				"\\documentclass[a4paper]{article}",
				" ",
				"\\usepackage[utf8]{inputenc}",
				"\\usepackage[T1]{fontenc}",
				"\\usepackage{textcomp}",
				"\\usepackage[dutch]{babel}",
				"\\usepackage{amsmath, amssymb}",
				" ",
				"\\usepackage{import}",
				"\\usepackage{xifthen}",
				"\\pdfminorversion=7",
				"\\usepackage{pdfpages}",
				"\\usepackage{transparent}",
				"\\newcommand{\\incfig}[1]{%",
				"		\\def\\svgwidth{\\columnwidth}",
"}",
				"\\pdfsuppresswarningpagegroup=1",
				" ",
				"\\begin{document}",
				"$0",
				"\\end{document}"
			]
		},
		"format": {
			"prefix": "beg",
			"body": [
				"\\begin{$1}",
				"$0",
				"\\end{$1}"
			]
		},
		"fraction" : {
			"prefix": "//",
			"body" : [
				"\\frac{$1}{$2}$0"
			]
		},
		"square": {
			"prefix": "sq",
			"body": [
				"$0^{2}"
			]
		},
		"exponent":{
			"prefix" : "ex",
			"body" : [
				"$0^{$1}"
			]
		},
		"root" : {
			"prefix": "rt",
			"body": [
				"\\sqrt{$1}$0"
			]
		},
		"nroot" : {
			"prefix": "nrt",
			"body" : [
				"\\sqrt[$1]{$2}$0"
			]
		},
		"limit" : {
			"prefix": "lim",
			"body": ["\\lim{{$1} \\to {$0}}"]
		},
		"d/dx": {
		"prefix": "ddx",
		"body": ["\\frac{d$0}{dx}"],
		"description": ""
		}, 
		"alpha" : {
			"prefix" : "a..",
			"body" : "\\alpha"
		},
		"beta" : {
			"prefix" : "b..",
			"body": "\\beta"
		},
		"gamma" : {
			"prefix" : "g..",
			"body" : "\\gamma"
		},
		"delta" : {
			"prefix" : "d..",
			"body" : "\\delta"
		},
		"theta" : {
			"prefix ": "t..",
			"body" : "\\theta"
		},
		"vtheta" : {
			"prefix ": "vt..",
			"body" : "\\vartheta"
		},
		"epsilon": {
			"prefix" : "e..",
			"body" : "\\epsilon"
		},
		"varepsilon": {
			"prefix" : "ve..",
			"body" : "\\varepsilon"
		},
		"mu":{
			"prefix" : "m..",
			"body": "\\mu"
		},
		"eta" : {
			"prefix": "h..",
			"body": "\\eta"
		},
		"Calpha" : {
			"prefix" : "a..",
			"body" : "\\alpha"
		},
		"Ctheta" : {
			"prefix" : "T..",
			"body": "\\Theta"
		},
		"Cgamma" : {
			"prefix" : "G..",
			"body" : "\\Gamma"
		},
		"Cdelta" : {
			"prefix" : "D..",
			"body" : "\\Delta"
		}
}
